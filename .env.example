# Variáveis privadas do servidor. Nunca coloque valores reais no Git ou em variáveis públicas.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_FALLBACK_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_EFFORT=medium
# Cérebro público: kazer.v1. O token fica somente no servidor.
HF_TOKEN=
HF_CHAT_ENDPOINT=https://router.huggingface.co/v1/chat/completions
KAZER_TEXT_MODEL=Qwen/Qwen3-8B
KAZER_TEXT_FALLBACK_MODEL=microsoft/Phi-4-mini-instruct
KAZER_VISION_MODEL=Qwen/Qwen3.8-27B
KAZER_VISION_FALLBACK_MODEL=google/gemma-3-4b-it
KAZER_REASONING_EFFORT=medium
# Modelo reservado para analisar fontes encontradas pelo Bing/DuckDuckGo.
KAZER_SEARCH_MODEL=Qwen/Qwen3.5-9B
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Lista opcional separada por vírgulas, sempre com https:// e sem barra final.
PUBLIC_APP_ORIGINS=https://seu-dominio.example
# Segurança: mantenha false até validar avisos, backup e procedimento de reversão.
RETENTION_DELETE_ENABLED=false

# Google Drive OAuth — crie um cliente Web no Google Cloud Console e registre o callback abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://seu-dominio.example/api/google-drive-callback
# Chave longa e aleatória; trocá-la invalida as autorizações armazenadas.
GOOGLE_DRIVE_TOKEN_KEY=

# GitHub OAuth para conectar repositórios dentro do Perfil.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=
# Obrigatória em produção; use pelo menos 32 caracteres aleatórios. Trocá-la invalida
# as autorizações armazenadas, portanto documente a rotação/recriptografia antes de mudar.
KAZER_CONNECTOR_ENCRYPTION_KEY=
