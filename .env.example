# Variáveis privadas do servidor. Nunca coloque valores reais no Git ou em variáveis públicas.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_FALLBACK_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_EFFORT=medium
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Lista opcional separada por vírgulas, sempre com https:// e sem barra final.
PUBLIC_APP_ORIGINS=https://seu-dominio.example
# Segurança: mantenha false até validar avisos, backup e procedimento de reversão.
RETENTION_DELETE_ENABLED=false

# Google Drive OAuth — crie um cliente Web no Google Cloud Console e registre o callback abaixo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://seu-dominio.example/api/google-drive-callback
# Chave longa e aleatória; trocá-la invalida as autorizações armazenadas.
GOOGLE_DRIVE_TOKEN_KEY=
