# Configuração local não sensível
KAZER_ENV=development
KAZER_LOG_LEVEL=INFO

# Tela de entrada e autenticação (valores não secretos)
KAZER_HOST=127.0.0.1
KAZER_PORT=8000
KAZER_PUBLIC_URL=http://localhost:8000
KAZER_DATABASE_PATH=data/kazer.db
# Supabase Kazer (URL e chave publicável; nunca cole a service-role key no frontend)
SUPABASE_URL=https://mqjunopzycdezzjmlhip.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Somente backend confiável/worker; nunca exponha, versione ou envie ao navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=http://localhost:8000/
# file: grava e-mails em data/outbox (só desenvolvimento) | smtp: envio real
KAZER_MAIL_BACKEND=file
KAZER_MAIL_FROM="KAZER <no-reply@localhost>"
# Produção exige true (padrão em production); false só para http://localhost
KAZER_COOKIE_SECURE=false
SMTP_PORT=587

# Modelo por trás do "KAZ 1.1" (vazio = chat sem modelo, sem respostas inventadas)
# xai | openai | anthropic | gemini | groq | deepseek | mistral | openrouter | together | ollama | custom
KAZER_MODEL_PROVIDER=
# Identificador do modelo no provedor (obrigatório, exceto anthropic: padrão claude-opus-5-5)
KAZER_MODEL=
# Opcionais: modelo do "Pensamento profundo", URL própria, imagens, nível de raciocínio
KAZER_MODEL_DEEP=
KAZER_MODEL_BASE_URL=
KAZER_MODEL_VISION=auto
KAZER_MODEL_REASONING=auto
KAZER_MODEL_WEB_SEARCH=false
KAZER_CHAT_HOURLY_UNITS=60
KAZER_CHAT_DAILY_UNITS=300
# Histórico leve: a conversa mais antiga sai quando uma nova entra acima deste total
KAZER_CHAT_MAX_CONVERSATIONS=100
# Usado só sem Supabase (desenvolvimento local); com Supabase os anexos vão para o bucket kazer-anexos
KAZER_UPLOAD_DIR=data/uploads

# Preencha localmente somente se necessário; nunca versione valores reais.
# Chaves de modelo: lidas só no servidor por kazer/security/secrets.py.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Groq: um modelo por nível de esforço (opcional; vazio = padrão do KAZER). Formato modelo:raciocínio,reserva
# KAZER_GROQ_MODEL_BAIXO=
# KAZER_GROQ_MODEL_MEDIO=
# KAZER_GROQ_MODEL_ALTO=
# KAZER_GROQ_MODEL_EXTRA=
# KAZER_GROQ_MODEL_MAX=
# KAZER_GROQ_VISION_MODEL=

# Pesquisa em tempo real: ligada por padrão e grátis (DuckDuckGo, Marginalia, Wikipédia,
# Google Notícias, GDELT, OpenAlex, arXiv, Stack Overflow, GitHub...).
# KAZER_WEB_TOOLS=true
# Opcional: seu SearXNG (github.com/searxng/searxng), grátis, junta dezenas de buscadores.
KAZER_SEARXNG_URL=
# Tavily: usada SÓ na pesquisa profunda (cota paga).
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Cobrança (Stripe): com a chave e os preços, a tela de planos abre o checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MENSAL=
STRIPE_PRICE_PRO_ANUAL=
STRIPE_PRICE_ULTRA_MENSAL=
STRIPE_PRICE_ULTRA_ANUAL=
# Webhook (Stripe → Desenvolvedores → Webhooks → https://SEU-DOMINIO/api/stripe/webhook,
# eventos checkout.session.completed, invoice.paid, customer.subscription.deleted).
STRIPE_WEBHOOK_SECRET=

# Modelos premium dos planos Pro/Ultra (cada um só aparece com a chave).
# ANTHROPIC_API_KEY=     # Claude (Haiku, Sonnet, Opus; Fable só no Ultra)
# OPENAI_API_KEY=        # GPT
# MOONSHOT_API_KEY=      # Kimi
# KAZER_OPENAI_MODEL=gpt-5.5
# KAZER_KIMI_MODEL=kimi-k2.6
# Corrigir preços (US$ por 1M tokens: entrada, saída) sem deploy de código:
# KAZER_MODEL_PRICES={"gpt": [5, 30], "kimi": [0.95, 4]}

# Divisão de cada assinatura (docs/NEGOCIO.md). Percentuais sobre o preço.
# KAZER_FEE_PCT=3.99
# KAZER_FEE_FIXED_CENTS=39
# KAZER_TAX_PCT=6
# KAZER_RESERVE_PCT=5
# KAZER_MARGIN_PCT=10
# KAZER_USD_BRL=5.50
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
KAZER_MODEL_API_KEY=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
DATABASE_URL=

# Criação de imagens (opcional). Sem isto a tela diz que a criação não está ligada.
# Aponte para um servidor de inferência SEU (ver docs/images/RUNTIME.md). O KAZER não
# chama nenhuma API paga de imagem por conta própria.
# Sem GPU: KAZER_IMAGE_PROVIDER=pollinations usa o serviço aberto da Pollinations
# (grátis e limitado por IP; com KAZER_POLLINATIONS_KEY, sem selo e sem limite por IP).
KAZER_IMAGE_PROVIDER=
KAZER_POLLINATIONS_KEY=
KAZER_POLLINATIONS_MODEL=
KAZER_IMAGE_ENDPOINT_URL=
KAZER_IMAGE_ENDPOINT_TOKEN=
KAZER_IMAGE_TIMEOUT=
