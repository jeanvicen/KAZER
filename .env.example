# Configuração local não sensível
KAZER_ENV=development
KAZER_LOG_LEVEL=INFO

# Tela de entrada e autenticação (valores não secretos)
KAZER_HOST=127.0.0.1
KAZER_PORT=8000
KAZER_PUBLIC_URL=http://localhost:8000
KAZER_DATABASE_PATH=data/kazer.db
# file: grava e-mails em data/outbox (só desenvolvimento) | smtp: envio real
KAZER_MAIL_BACKEND=file
KAZER_MAIL_FROM="KAZER <no-reply@localhost>"
# Produção exige true (padrão em production); false só para http://localhost
KAZER_COOKIE_SECURE=false
SMTP_PORT=587

# Modelo por trás do "KAZ 1.1" (vazio = chat sem modelo, sem respostas inventadas)
# xai | openai | anthropic | gemini | groq | deepseek | mistral | openrouter | together | ollama | custom
KAZER_MODEL_PROVIDER=
# Identificador do modelo no provedor (obrigatório, exceto anthropic: padrão claude-opus-5-5)
KAZER_MODEL=
# Opcionais: modelo do "Pensamento profundo", URL própria, imagens, nível de raciocínio
KAZER_MODEL_DEEP=
KAZER_MODEL_BASE_URL=
KAZER_MODEL_VISION=auto
KAZER_MODEL_REASONING=auto
KAZER_MODEL_WEB_SEARCH=false
KAZER_CHAT_HOURLY_UNITS=60
KAZER_CHAT_DAILY_UNITS=300
KAZER_UPLOAD_DIR=data/uploads

# Preencha localmente somente se necessário; nunca versione valores reais.
# Chaves de modelo: lidas só no servidor por kazer/security/secrets.py.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
KAZER_MODEL_API_KEY=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
DATABASE_URL=
